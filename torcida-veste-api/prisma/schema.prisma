generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Order {
  id           String       @id @unique @default(uuid())
  payment_id   String
  payment_url  String
  order_status ORDER_STATUS
  created_at   DateTime
  updated_at   DateTime
  OrderItems   OrderItem[]
  address_id   String
  Address      Address      @relation(fields: [address_id], references: [id])
  client_id    String
  Client       Client       @relation(fields: [client_id], references: [id])
}

model Address {
  id                 String  @id @unique @default(uuid())
  clientZipCode      String
  clientAddress      String
  clientNumber       String
  clientComplement   String?
  clientNeighborhood String?
  clientCity         String
  clientState        String
  Order              Order[]
  Client             Client[]
}

model User {
  id       Int      @id @unique @default(autoincrement())
  email    String   @unique
  password String
  role     ROLE
}

model Client {
  id              String  @id @unique @default(uuid())
  clientFirstName String
  clientLastName  String
  clientEmail     String
  clientCpf       String
  clientPhone     String
  address_id      String
  Address         Address      @relation(fields: [address_id], references: [id])
  Order           Order[]
  role            ROLE
}

model OrderItem {
  id         String  @id @unique @default(uuid())
  product_id String
  order_id   String
  coupon_id  String
  quantity   Float
  Product    Product @relation(fields: [product_id], references: [id])
  Order      Order   @relation(fields: [order_id], references: [id])
  Coupon     Coupon  @relation(fields: [coupon_id], references: [id])
}

model Product {
  id           String       @id @unique @default(uuid())
  name         String
  size         String
  stock_status STOCK_STATUS
  category_id  String
  league_id    String
  Category     Category     @relation(fields: [category_id], references: [id])
  League       League       @relation(fields: [league_id], references: [id])
  OrderItems   OrderItem[]
  Images       Image[]
}

model Coupon {
  id            String        @id @unique @default(uuid())
  code          String
  discount_type DISCOUNT_TYPE
  OrderItems    OrderItem[]
}

model Image {
  id         String   @id @unique @default(uuid())
  url        String
  key        String
  is_Cover   Boolean
  product_id String
  Product    Product  @relation(fields: [product_id], references: [id])
}

model Category {
  id       String    @id @unique @default(uuid())
  name     String
  Products Product[]
}

model League {
  id       String    @id @unique @default(uuid())
  name     String
  Products Product[]
}

enum ROLE {
  ADMIN
  CLIENT
}

enum ORDER_STATUS {
  RECEIVED
  PROCESSING
  SENT
  CONCLUDED
  CANCELED
}

enum DISCOUNT_TYPE {
  PERCENTAGE
  VALUE
}

enum SHIPMENT_TYPE {
  DELIVERY
  REMOVAL
}

enum STOCK_STATUS {
  IN_STOCK
  OUT_OF_STOCK
}
