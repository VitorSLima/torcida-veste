generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Address {
  id           String  @id @unique @default(uuid())
  zipCode      String
  street       String
  number       String
  complement   String?
  neighborhood String?
  city         String
  state        String
  User         User[]
}

model Category {
  id       String    @id @unique @default(uuid())
  name     String
  Products Product[]
}

model Coupon {
  id            String        @id @unique @default(uuid())
  code          String
  expiration_at String
  value         Float?
  Order         Order[]
  discount_type DISCOUNT_TYPE
}

model Image {
  id         String  @id @unique @default(uuid())
  url        String
  key        String
  is_Cover   Boolean
  product_id String
  Product    Product @relation(fields: [product_id], references: [id])
}

model League {
  id       String    @id @unique @default(uuid())
  name     String
  Products Product[]
}

model Order {
  id           String       @id @unique @default(uuid())
  payment_id   String
  payment_url  String
  created_at   String
  updated_at   String
  person_id    String
  order_status ORDER_STATUS
  OrderItems   OrderItem[]
  coupon_id    String
  Coupon       Coupon       @relation(fields: [coupon_id], references: [id])
}

model OrderItem {
  id         String  @id @unique @default(uuid())
  product_id String
  order_id   String
  quantity   Float
  Product    Product @relation(fields: [product_id], references: [id])
  Order      Order   @relation(fields: [order_id], references: [id])
}

model Product {
  id           String       @id @unique @default(uuid())
  name         String
  size         String
  description  String
  price        Float
  originalPrice Float?
  stock_status STOCK_STATUS
  category_id  String
  league_id    String
  Images       Image[]
  OrderItems   OrderItem[]
  Category     Category     @relation(fields: [category_id], references: [id])
  League       League       @relation(fields: [league_id], references: [id])
}

model Session {
  id            String   @id
  refresh_token String
  expires_at    DateTime
  user_id       String
  User          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("sessions")
}

model User {
  id         String    @id @unique @default(uuid())
  email      String    @unique
  password   String?
  firstName  String
  lastName   String
  picture    String?
  document   String?
  phone      String?
  address_id String?
  role       ROLE?
  sessions   Session[]
  authCodes  AuthCode[]
  Address    Address?   @relation(fields: [address_id], references: [id])
}

model AuthCode {
  id         String   @id @default(uuid())
  code_hash  String   @unique
  user_id    String
  expires_at DateTime
  User       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("auth_codes")
}

enum ROLE {
  ADMIN
  USER
}

enum ORDER_STATUS {
  RECEIVED
  PROCESSING
  SENT
  CONCLUDED
  CANCELED
}

enum DISCOUNT_TYPE {
  PERCENTAGE
  VALUE
}

enum SHIPMENT_TYPE {
  DELIVERY
  REMOVAL
}

enum STOCK_STATUS {
  IN_STOCK
  OUT_OF_STOCK
}
